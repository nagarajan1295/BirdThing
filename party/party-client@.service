[Unit]
Description=House Party snapclient for speaker %i
After=bluealsa.service network-online.target

[Service]
User=adithya
# instance = MAC without colons; hostID doubles as the snapcast client id so
# per-speaker latency trims stick. 400 ms ALSA buffer rides out Bluetooth/WiFi
# radio sharing on the Pi's combo chip (the cause of the crackle).
ExecStart=/opt/party/client.sh %i
Restart=on-failure
RestartSec=3
