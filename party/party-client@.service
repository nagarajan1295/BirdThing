[Unit]
Description=House Party snapclient for speaker %i
After=bluealsa.service snapserver.service

[Service]
User=_snapclient
# instance = MAC without colons; hostID doubles as the snapcast client id so
# per-speaker latency trims stick. RT priority: the mini also runs Sentry's YOLO.
ExecStart=/opt/party/client.sh %i
Nice=-15
CPUSchedulingPolicy=rr
CPUSchedulingPriority=20
Restart=on-failure
RestartSec=3
